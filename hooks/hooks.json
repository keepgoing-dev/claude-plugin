{
  "description": "KeepGoing session continuity hooks - auto-saves checkpoints and shows momentum on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @keepgoingdev/mcp-server --print-momentum"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @keepgoingdev/mcp-server --update-task-from-hook"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @keepgoingdev/mcp-server --heartbeat"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @keepgoingdev/mcp-server --save-checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @keepgoingdev/mcp-server --save-checkpoint"
          }
        ]
      }
    ]
  }
}
