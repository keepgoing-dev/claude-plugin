{
  "description": "KeepGoing session continuity hooks - auto-saves checkpoints and shows momentum on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepgoing momentum --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "keepgoing task-update --hook"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "keepgoing heartbeat --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepgoing save --hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepgoing save --hook"
          }
        ]
      }
    ]
  }
}
